    <!-- Paramètres de sauvegarde -->
    <string name="backup_settings_title">Paramètres de sauvegarde</string>
    <string name="backup_restore_version_title">Restaurer cette version ?</string>
    <string name="backup_restore_version_text">Les carnets, dossiers et notes de lecture du %1$s sont ajoutés à votre bibliothèque sous forme de copies. Rien n'est supprimé de votre bibliothèque actuelle.</string>
    <string name="backup_smart_title">Sauvegardes intelligentes</string>
    <string name="backup_explanation">Sauvegarde quelques minutes après la fermeture d'une note ou de l'application, uniquement si quelque chose a changé. Conserve les versions récentes et supprime automatiquement les anciennes. Les fichiers PDF et EPUB ne sont pas copiés ; vos notes et surlignages, si.</string>
    <string name="backup_on_status">Activée : sauvegarde après les modifications</string>
    <string name="backup_choose_to_start">Choisissez un dossier pour commencer</string>
    <string name="backup_on_detail">Votre première sauvegarde démarre après le choix du dossier. Pendant les longues sessions, Folio sauvegarde aussi environ toutes les 15 minutes, et vérifie toutes les quelques heures au cas où quelque chose aurait été oublié. Android peut retarder les tâches en arrière-plan.</string>
    <string name="backup_off_detail">Activez les sauvegardes pour choisir un dossier. Annuler le choix du dossier laisse les sauvegardes désactivées.</string>
    <string name="backup_files_kept">Les fichiers de sauvegarde existants sont conservés quand la sauvegarde est désactivée.</string>
    <string name="backup_folder">Dossier de sauvegarde</string>
    <string name="backup_change_folder">Changer de dossier</string>
    <string name="backup_last">Dernière sauvegarde</string>
    <string name="backup_state_setting_up">Configuration</string>
    <string name="backup_state_running">Sauvegarde…</string>
    <string name="backup_state_attention">Action requise</string>
    <string name="backup_state_on">Activée</string>
    <string name="backup_state_off">Désactivée</string>
    <string name="backup_saving_notes">Enregistrement de vos dernières notes…</string>
    <string name="backup_now">Sauvegarder maintenant</string>
    <string name="backup_versions">Versions conservées</string>
    <string name="backup_documents_title">Choisissez un dossier dans Documents</string>
    <string name="backup_documents_detail">Dans le sélecteur de dossiers Android, ouvrez Documents. Vous pouvez créer un dossier nommé Folio Backups, l'ouvrir, puis toucher Utiliser ce dossier.</string>
    <string name="backup_format_detail">Une sauvegarde .folio inclut les carnets et leurs pièces jointes, ainsi que les titres du lecteur, les références de fichiers, les positions de lecture, les surlignages et les notes. Les fichiers PDF et EPUB restent dans le stockage de cet appareil et ne sont pas copiés ; après une restauration sur un autre appareil, réimportez un livre pour le rouvrir. Les livres correspondants retrouvent leurs annotations enregistrées. La restauration ajoute des copies et n'efface jamais votre bibliothèque. Les sauvegardes restent sur cet appareil ; rien n'est envoyé en ligne.</string>
    <string name="backup_restore_from">Restaurer depuis une sauvegarde</string>

