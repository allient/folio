    <string name="backup_saving_notes">Saving your latest notes…</string>
    <string name="backup_now">Back up now</string>
    <string name="backup_versions">Kept versions</string>
    <string name="backup_documents_title">Choose a folder in Documents</string>
    <string name="backup_documents_detail">In the Android folder picker, open Documents. You can create a folder called Folio Backups, open it, then tap Use this folder.</string>
    <string name="backup_format_detail">A .folio backup includes notebooks and their attachments, plus reader titles, file references, reading positions, highlights and notes. PDF and EPUB files stay in this device's storage and are not copied; after restoring on another device, reimport a book to reopen it. Matching books reconnect to their saved annotations. Restoring adds copies and never erases your library. Backups stay on this device; nothing is sent online.</string>
