    <string name="backup_settings_title">Backup settings</string>
    <string name="backup_restore_version_title">Restore this version?</string>
    <string name="backup_restore_version_text">Notebooks, folders and reader notes from %1$s are added to your library as copies. Nothing in your current library is removed.</string>
    <string name="backup_smart_title">Smart backups</string>
    <string name="backup_explanation">Backs up a few minutes after you close a note or leave the app, only when something changed. Keeps recent versions and removes old ones automatically. PDF and EPUB files aren't copied; your notes and highlights are.</string>
    <string name="backup_on_status">On: backs up after changes</string>
    <string name="backup_choose_to_start">Choose a folder to get started</string>
    <string name="backup_on_detail">Your first backup starts after folder selection. During long sessions Folio also backs up about every 15 minutes, and checks every few hours in case anything was missed. Android may delay background work.</string>
    <string name="backup_off_detail">Turn on backups to select a folder. Cancelling folder selection leaves backups off.</string>
    <string name="backup_files_kept">Existing backup files are kept when backup is off.</string>
    <string name="backup_folder">Backup folder</string>
