    <!-- Backup settings -->
    <string name="backup_settings_title">बैकअप सेटिंग</string>
    <string name="backup_restore_version_title">यह वर्शन रीस्टोर करें?</string>
    <string name="backup_restore_version_text">%1$s की नोटबुक, फ़ोल्डर और रीडर नोट्स कॉपी के रूप में आपकी लाइब्रेरी में जोड़े जाएंगे। आपकी मौजूदा लाइब्रेरी से कुछ नहीं हटाया जाएगा।</string>
    <string name="backup_smart_title">स्मार्ट बैकअप</string>
    <string name="backup_explanation">कोई नोट बंद करने या ऐप छोड़ने के कुछ मिनट बाद बैकअप लेता है, सिर्फ़ तब जब कुछ बदला हो। हाल के वर्शन रखता है और पुराने अपने-आप हटा देता है। PDF और EPUB फ़ाइलें कॉपी नहीं होतीं; आपके नोट और हाइलाइट होते हैं।</string>
    <string name="backup_on_status">चालू: बदलावों के बाद बैकअप लेता है</string>
    <string name="backup_choose_to_start">शुरू करने के लिए कोई फ़ोल्डर चुनें</string>
    <string name="backup_on_detail">फ़ोल्डर चुनने के बाद आपका पहला बैकअप शुरू होता है। लंबे सेशन में Folio लगभग हर 15 मिनट में भी बैकअप लेता है, और कुछ छूट गया हो तो हर कुछ घंटों में जांचता है। Android बैकग्राउंड के काम में देरी कर सकता है।</string>
    <string name="backup_off_detail">फ़ोल्डर चुनने के लिए बैकअप चालू करें। फ़ोल्डर चुनना रद्द करने पर बैकअप बंद रहता है।</string>
