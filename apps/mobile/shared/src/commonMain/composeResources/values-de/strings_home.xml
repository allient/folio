    <!-- Backup settings -->
    <string name="backup_settings_title">Sicherungseinstellungen</string>
    <string name="backup_restore_version_title">Diese Version wiederherstellen?</string>
    <string name="backup_restore_version_text">Notizbücher, Ordner und Lesenotizen vom %1$s werden deiner Bibliothek als Kopien hinzugefügt. In deiner aktuellen Bibliothek wird nichts entfernt.</string>
    <string name="backup_smart_title">Intelligente Sicherungen</string>
    <string name="backup_explanation">Sichert wenige Minuten, nachdem du eine Notiz schließt oder die App verlässt, und nur, wenn sich etwas geändert hat. Behält aktuelle Versionen und entfernt alte automatisch. PDF- und EPUB-Dateien werden nicht kopiert, deine Notizen und Markierungen schon.</string>
    <string name="backup_on_status">An: sichert nach Änderungen</string>
    <string name="backup_choose_to_start">Wähle einen Ordner, um zu beginnen</string>
    <string name="backup_on_detail">Deine erste Sicherung startet nach der Ordnerauswahl. Bei langen Sitzungen sichert Folio außerdem etwa alle 15 Minuten und prüft alle paar Stunden, ob etwas verpasst wurde. Android kann Hintergrundarbeit verzögern.</string>
    <string name="backup_off_detail">Aktiviere Sicherungen, um einen Ordner auszuwählen. Wird die Ordnerauswahl abgebrochen, bleiben Sicherungen aus.</string>
    <string name="backup_files_kept">Vorhandene Sicherungsdateien bleiben erhalten, wenn die Sicherung aus ist.</string>
    <string name="backup_folder">Sicherungsordner</string>
    <string name="backup_change_folder">Ordner ändern</string>
    <string name="backup_last">Letzte Sicherung</string>
    <string name="backup_state_setting_up">Wird eingerichtet</string>
    <string name="backup_state_running">Wird gesichert…</string>
    <string name="backup_state_attention">Aktion erforderlich</string>
    <string name="backup_state_on">An</string>
    <string name="backup_state_off">Aus</string>
    <string name="backup_saving_notes">Deine neuesten Notizen werden gespeichert…</string>
    <string name="backup_now">Jetzt sichern</string>
    <string name="backup_versions">Aufbewahrte Versionen</string>
    <string name="backup_documents_title">Wähle einen Ordner in „Documents“</string>
    <string name="backup_documents_detail">Öffne in der Android-Ordnerauswahl „Documents“. Du kannst einen Ordner namens „Folio Backups“ erstellen, ihn öffnen und dann auf „Diesen Ordner verwenden“ tippen.</string>
    <string name="backup_format_detail">Eine .folio-Sicherung enthält Notizbücher und ihre Anhänge sowie Buchtitel aus dem Reader, Dateiverweise, Lesepositionen, Markierungen und Notizen. PDF- und EPUB-Dateien bleiben im Speicher dieses Geräts und werden nicht kopiert; importiere ein Buch nach dem Wiederherstellen auf einem anderen Gerät erneut, um es wieder zu öffnen. Passende Bücher werden wieder mit ihren gespeicherten Anmerkungen verknüpft. Das Wiederherstellen fügt Kopien hinzu und löscht nie deine Bibliothek. Sicherungen bleiben auf diesem Gerät; nichts wird online gesendet.</string>
    <string name="backup_restore_from">Aus Sicherung wiederherstellen</string>

