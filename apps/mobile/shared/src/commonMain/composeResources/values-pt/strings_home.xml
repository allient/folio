    <!-- Backup settings -->
    <string name="backup_settings_title">Configurações de backup</string>
    <string name="backup_restore_version_title">Restaurar esta versão?</string>
    <string name="backup_restore_version_text">Cadernos, pastas e notas de leitura de %1$s são adicionados à sua biblioteca como cópias. Nada da sua biblioteca atual é removido.</string>
    <string name="backup_smart_title">Backups inteligentes</string>
    <string name="backup_explanation">Faz backup alguns minutos depois que você fecha uma nota ou sai do app, só quando algo mudou. Mantém as versões recentes e remove as antigas automaticamente. Arquivos PDF e EPUB não são copiados; suas notas e destaques são.</string>
    <string name="backup_on_status">Ativado: faz backup após alterações</string>
    <string name="backup_choose_to_start">Escolha uma pasta para começar</string>
    <string name="backup_on_detail">Seu primeiro backup começa depois que você escolhe a pasta. Em sessões longas, o Folio também faz backup a cada 15 minutos, mais ou menos, e verifica a cada poucas horas caso algo tenha ficado de fora. O Android pode atrasar tarefas em segundo plano.</string>
    <string name="backup_off_detail">Ative os backups para escolher uma pasta. Se você cancelar a escolha da pasta, os backups ficam desativados.</string>
    <string name="backup_files_kept">Os arquivos de backup existentes são mantidos quando o backup está desativado.</string>
    <string name="backup_folder">Pasta de backup</string>
    <string name="backup_change_folder">Trocar pasta</string>
    <string name="backup_last">Último backup</string>
    <string name="backup_state_setting_up">Configurando</string>
    <string name="backup_state_running">Fazendo backup…</string>
    <string name="backup_state_attention">Precisa de atenção</string>
    <string name="backup_state_on">Ativado</string>
    <string name="backup_state_off">Desativado</string>
    <string name="backup_saving_notes">Salvando suas notas mais recentes…</string>
    <string name="backup_now">Fazer backup agora</string>
    <string name="backup_versions">Versões mantidas</string>
    <string name="backup_documents_title">Escolha uma pasta em Documentos</string>
    <string name="backup_documents_detail">No seletor de pastas do Android, abra Documentos. Você pode criar uma pasta chamada Folio Backups, abri-la e tocar em Usar esta pasta.</string>
    <string name="backup_format_detail">Um backup .folio inclui os cadernos e seus anexos, além dos títulos do leitor, referências de arquivos, posições de leitura, destaques e notas. Arquivos PDF e EPUB ficam no armazenamento deste dispositivo e não são copiados; depois de restaurar em outro dispositivo, importe o livro de novo para reabri-lo. Livros correspondentes se reconectam às anotações salvas. Restaurar adiciona cópias e nunca apaga sua biblioteca. Os backups ficam neste dispositivo; nada é enviado pela internet.</string>
    <string name="backup_restore_from">Restaurar de um backup</string>

