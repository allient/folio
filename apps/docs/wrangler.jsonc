{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Static Astro site served from Workers Static Assets. One environment only.
	"name": "folio-docs",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"workers_dev": true,
	"preview_urls": false,
	// Workers Logs and traces in the dashboard (Workers & Pages › folio-docs › Observability).
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": true,
		"logs": { "enabled": true, "invocation_logs": true },
		"traces": { "enabled": true }
	}
}
