{
	"$schema": "../../node_modules/wrangler/config-schema.json",
	// Static Astro site served from Workers Static Assets. One environment only.
	// worker/index.ts runs first for pages and agent files (Markdown negotiation, Link headers, CORS);
	// built assets (_astro, fonts, pagefind, images) are served directly without invoking it.
	"name": "folio-docs",
	"main": "./worker/index.ts",
	"compatibility_date": "2026-10-01",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"run_worker_first": ["/*", "!/_astro/*", "!/fonts/*", "!/pagefind/*", "!/favicon.svg", "!/og.png"],
		"not_found_handling": "404-page",
		"html_handling": "auto-trailing-slash"
	},
	"workers_dev": true,
	"preview_urls": false,
	// Workers Logs and traces in the dashboard (Workers & Pages › folio-docs › Observability).
	"observability": {
		"enabled": true,
		"head_sampling_rate": 1,
		"redact_query_string": true,
		"logs": { "enabled": true, "invocation_logs": true },
		"traces": { "enabled": true }
	}
}
